{
  "name": "spectra-desktop",
  "productName": "Spectra Desktop",
  "version": "0.2.0",
  "description": "Spectra Desktop by Actecal: a free DICOM viewer for Windows, macOS and Linux",
  "author": {
    "name": "Actecal Private Limited",
    "email": "sales@actecal.com",
    "url": "https://actecal.com"
  },
  "homepage": "https://actecal.com/tools/dicom-viewer",
  "license": "MIT",
  "private": true,
  "main": "src/main/index.js",
  "scripts": {
    "viewer": "node scripts/build-viewer.mjs",
    "viewer:copy": "node scripts/build-viewer.mjs --copy-only",
    "start": "electron .",
    "icon": "electron scripts/make-icon.cjs",
    "test": "node --test \"test/*.test.mjs\"",
    "e2e": "node test-e2e/run.mjs",
    "e2e:packaged": "node test-e2e/packaged.mjs",
    "pack": "electron-builder --config electron-builder.config.cjs --dir",
    "dist": "electron-builder --config electron-builder.config.cjs --publish never"
  },
  "dependencies": {
    "dcmjs": "0.49.4"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "electron": "44.9.3",
    "electron-builder": "26.18.0",
    "playwright-core": "1.65.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
